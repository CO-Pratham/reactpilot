      "types": "./dist/ui/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/ui/index.ts --format esm --dts",
    "lint": "eslint src --ext .ts",
    "test": "vitest"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "enquirer": "^2.4.1",
    "ora": "^8.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "eslint": "^9.10.0",
    "tsup": "^8.3.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
